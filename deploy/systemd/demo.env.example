# Copy to /etc/demo-observability/demo.env and replace DEMO_ADMIN_TOKEN.
DEMO_API_ADDR=127.0.0.1:8080
DEMO_TEMP_DIR=/var/lib/demo-observability/tmp
DEMO_MAX_MEMORY_MB=48
DEMO_ADMIN_TOKEN=replace-with-a-long-random-token

DEMO_TARGET_URL=http://127.0.0.1:8080
DEMO_LOAD_PROFILE=loop
DEMO_LOAD_MAX_CONCURRENT=12

